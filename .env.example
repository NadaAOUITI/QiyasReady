# Copy to `server/.env` (recommended) or project root `.env` — both are loaded.
# Server
PORT=3001
JWT_SECRET=change-me-in-production-min-32-chars-long
# Groq — https://console.groq.com/keys  (restart server after changing)
GROQ_API_KEY=
# Optional override if default is deprecated (default: llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant
